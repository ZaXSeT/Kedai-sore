# Koneksi Postgres untuk fungsi server.
# Lokal  : postgres://postgres:postgres-lokal@127.0.0.1:55402/kedai_sore  (npm run db:start)
# Vercel : Supabase transaction pooler, port 6543 (Settings → Database → Connection string → Transaction)
DATABASE_URL=

# Opsional, hanya untuk tes: database tes terpisah. Kosong = Postgres lokal tertanam (kedai_sore_test).
TEST_DATABASE_URL=
